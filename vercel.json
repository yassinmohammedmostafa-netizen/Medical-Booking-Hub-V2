{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/uploads/(.*)", "destination": "/artifacts/api-server/uploads/$1" },
    { "source": "/((?!api|uploads).*\\..*)", "destination": "/artifacts/esaal/dist/public/$1" },
    { "source": "/(.*)", "destination": "/artifacts/esaal/dist/public/index.html" }
  ]
}
